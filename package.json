{
  "name": "pt-luyoa",
  "private": true,
  "type": "module",
  "description": "Copiloto de negocio para Café Alborada: servidor MCP, agente e interfaz de chat con respuestas visuales.",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "pnpm --filter @alborada/web dev",
    "build": "pnpm --filter @alborada/web build",
    "verify": "pnpm format:check && pnpm lint && pnpm check:comments && pnpm typecheck && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "check:comments": "tsx scripts/quality/check-bilingual-comments.ts",
    "typecheck": "pnpm -r typecheck && tsc -p scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp:stdio": "pnpm --filter @alborada/mcp-server stdio",
    "golden": "pnpm --filter @alborada/evals golden",
    "eval": "pnpm --filter @alborada/evals eval",
    "compare": "pnpm --filter @alborada/evals compare",
    "rescore": "pnpm --filter @alborada/evals rescore"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.5",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
