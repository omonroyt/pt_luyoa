{
  "name": "@alborada/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Servidor MCP alrededor de la API de Café Alborada, con herramientas diseñadas para un agente.",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "alborada-mcp": "./src/cli.ts"
  },
  "scripts": {
    "stdio": "tsx --env-file-if-exists=../../.env src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@alborada/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
