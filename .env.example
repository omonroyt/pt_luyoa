# Copia este archivo como .env y llena los valores. El .env nunca se sube al repositorio.

# --- API de Café Alborada -------------------------------------------------
# Genera tu llave en https://prueba-developer.luyoa.dev (panel "Tu llave de API").
LUYOA_API_KEY=
LUYOA_API_BASE_URL=https://prueba-developer.luyoa.dev

# --- OpenRouter -----------------------------------------------------------
# La llave está en la misma página de Luyoa.
OPENROUTER_API_KEY=
# Modelo del agente y del juez de evaluaciones (se fijan tras la comparación de modelos).
OPENROUTER_MODEL=
OPENROUTER_JUDGE_MODEL=

# --- Secretos internos ----------------------------------------------------
# Valores aleatorios largos. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Firma los tokens de aprobación de campañas.
APPROVAL_SECRET=
# Protege el endpoint HTTP del servidor MCP (/api/mcp).
MCP_SERVICE_TOKEN=

# --- Base de datos --------------------------------------------------------
# Local: archivo SQLite. En la nube: URL de Turso + token.
DATABASE_URL=file:./data/local.db
DATABASE_AUTH_TOKEN=

# --- Demo publicada -------------------------------------------------------
# Código de acceso para entrar a la demo. Vacío = sin código (solo en local).
DEMO_ACCESS_CODE=

# --- Opcional: trazas en Langfuse -----------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=
