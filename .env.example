# Plantilla de configuración. Los valores reales viven en .env (ignorado por git, nunca se versiona).

# --- API de Café Alborada -------------------------------------------------
# Llave generada en https://prueba-developer.luyoa.dev (panel "Tu llave de API").
LUYOA_API_KEY=
LUYOA_API_BASE_URL=https://prueba-developer.luyoa.dev

# --- OpenRouter -----------------------------------------------------------
# Llave con límite de gasto, emitida en https://prueba-developer.luyoa.dev.
OPENROUTER_API_KEY=
# Modelo del agente y modelo juez de las evaluaciones (definidos por la comparación de modelos, ADR-13).
OPENROUTER_MODEL=
OPENROUTER_JUDGE_MODEL=

# --- Secretos internos ----------------------------------------------------
# Valores aleatorios de 32 bytes en base64url:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Firma HMAC de los tokens de aprobación de campañas (ADR-08).
APPROVAL_SECRET=
# Autenticación del endpoint HTTP del servidor MCP (/api/mcp).
MCP_SERVICE_TOKEN=
# Secreto con el que Vercel Cron llama /api/cron/weekly (resumen semanal). Vacío deshabilita el cron.
CRON_SECRET=

# --- Base de datos --------------------------------------------------------
# Local: archivo SQLite. Despliegue: URL de Turso y su token.
DATABASE_URL=file:./data/local.db
DATABASE_AUTH_TOKEN=

# --- Demo publicada -------------------------------------------------------
# Código de acceso a la demo. Vacío deshabilita la protección (solo desarrollo local).
DEMO_ACCESS_CODE=

# --- Trazas en Langfuse (opcional) ----------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=
